{
  "name": "dsh-llm-opencode-session",
  "version": "0.1.0",
  "description": "DSH Forge LLM host plugin: sends a stable per-conversation `x-opencode-session` header on opencode.ai gateway requests (OpenCode Zen / Go), which the upstream pi-ai adapter does not send yet.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node test/plugin.test.cjs"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "typescript": "^6.0.3"
  }
}
